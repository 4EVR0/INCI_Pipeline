# =========================
# 공통
# =========================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=ap-northeast-2
S3_BUCKET=your-s3-bucket

# 배치 기준 (직접 수정)
BATCH_MONTH=YYYY-MM
INGEST_DATE=YYYY-MM-DD

# =========================
# KCIA Bronze
# =========================
KCIA_BASE_URL=https://kcia.or.kr/cid/search/ingd_list.php
KCIA_S3_PREFIX=INCI_data/kcia
KCIA_REQUEST_SLEEP=0.35
KCIA_TIMEOUT=15
KCIA_MAX_RETRIES=5
KCIA_STRICT_COUNT_CHECK=true
KCIA_RESUME_ENABLED=true
KCIA_CLEAR_CHECKPOINT_ON_SUCCESS=true

# =========================
# CosIng Bronze
# =========================
COSING_API_BASE_URL=https://ec.europa.eu/growth/tools-databases/cosing/api
COSING_S3_PREFIX=INCI_data/cosing
COSING_REQUEST_SLEEP=0.2
COSING_TIMEOUT=30
COSING_MAX_RETRIES=5
COSING_SAFE_LIMIT=9500
COSING_COUNT_CACHE_ENABLED=true

# CosIng API key (직접 입력)
COSING_API_KEY=your-cosing-api-key

# =========================
# Silver Mapping
# =========================
MAPPING_INPUT_MODE=bronze_local
FUZZY_AUTO_THRESHOLD=95
FUZZY_REVIEW_THRESHOLD=90
SAVE_INTERMEDIATE=true

# Silver 매핑용 로컬 입력 경로 (직접 입력)
KCIA_LOCAL_PATH=bronze/kcia/batch=YYYY-MM/kcia_bronze.csv
COSING_LOCAL_PATH=bronze/cosing/batch=YYYY-MM/cosing_bronze.csv

# =========================
# Iceberg (Bronze → Iceberg 저장 시 필요)
# =========================
ICEBERG_WAREHOUSE_PATH=s3://your-s3-bucket/inci_iceberg_metadata
AWS_REGION=ap-northeast-2

# =========================
# Silver / Gold S3
# =========================
S3_SILVER_PREFIX=INCI_data_silver/
S3_GOLD_PREFIX=INCI_data_gold/

# Gold 로컬 입력은 BATCH_MONTH와 무관하게 silver/kcia_cosing/batch=*/ 중 최신(YYYY-MM 최대)을 사용